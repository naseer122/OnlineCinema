<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="#171F28E5"
    android:layout_height="match_parent"
    tools:context=".PaymentCheckPoint">
    <androidx.cardview.widget.CardView
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        app:cardCornerRadius="10dp"
        android:padding="10dp"
        android:elevation="10dp"
        android:layout_width="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/DetailThumbnail"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_margin="5dp"
                android:scaleType="fitXY"
                android:src="@drawable/appstartup" />


        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/payment">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="If You are facing any issue in Payment Please contact us on whatsapp by clicking on whatsapp ICON"/>
        <ImageView
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            android:id="@+id/contact_whatsapp"
            android:layout_width="56dp"
            android:layout_marginBottom="10dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_whatsapp_square" />
        <LinearLayout
            android:id="@+id/easypaisaLL"
            android:layout_margin="10dp"
            android:layout_gravity="center"
            android:background="@drawable/edit_bg"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_height="50dp"
                android:layout_width="30dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
               android:layout_marginEnd="10dp"
                android:src="@drawable/images"/>
            <TextView
                android:id="@+id/timerTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EASY PAISA"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="18sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/googleLL"
            android:background="@drawable/edit_bg"
            android:layout_margin="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_marginTop="10dp"
                android:layout_marginBottom="5dp"
                android:layout_height="50dp"
                android:layout_marginEnd="10dp"
                android:layout_width="30dp"
                android:src="@drawable/google"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="Credit Card or Debit Card"
                android:gravity="center"
                android:textStyle="bold"
                android:textSize="18sp"/>
        </LinearLayout>




    </LinearLayout>

</LinearLayout>